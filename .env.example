# Nexus Digital Dental Lab - Environment Variables
# Supabase Configuration (from your Supabase project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Server-only Service Role Key (NEVER expose to browser/client-side)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site URL (for redirects, auth callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
